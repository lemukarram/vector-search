{
    "name": "lemukarram/laravel-ai-rag",
    "description": "The Ultimate Laravel AI RAG Package. Seamlessly integrate Vector Search with GPT-5.5, Gemini 2.5, and Claude 4.6. Advanced semantic search for Eloquent models.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mukarram Hussain",
            "email": "le.mukarram@gmail.com",
            "homepage": "https://github.com/lemukarram",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "LeMukarram\\VectorSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeMukarram\\VectorSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LeMukarram\\VectorSearch\\VectorSearchServiceProvider"
            ],
            "aliases": {
                "VectorSearch": "LeMukarram\\VectorSearch\\Facades\\VectorSearch"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
